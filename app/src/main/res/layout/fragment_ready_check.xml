<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textReadyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready Check"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textReadyLobbySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Lobby summary unavailable."
            android:textSize="15sp" />

        <TextView
            android:id="@+id/textReadyCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ready check open for: 0s"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/progressReadyCheck"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/textPlayersHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Players"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textPlayersList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No players found."
            android:textSize="15sp" />

        <Button
            android:id="@+id/buttonToggleReady"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Mark Ready" />

        <Button
            android:id="@+id/buttonMarkAllReady"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Mark Everyone Ready (Demo)" />

        <Button
            android:id="@+id/buttonStartMatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Start Match" />

        <TextView
            android:id="@+id/textReadyStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Status: Waiting for players."
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>